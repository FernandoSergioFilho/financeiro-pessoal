{
  "name": "financeiro-pessoal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Controle financeiro pessoal — lançamentos, contas recorrentes e compras parceladas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode singlefile && node scripts/build-single.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "verificar-seguranca": "node scripts/verificar-seguranca.mjs",
    "test:telas": "node test-navegador/campos-de-data.mjs",
    "test:simulacao": "node test-navegador/simulacao.mjs",
    "test:dialogos": "node test-navegador/dialogos.mjs",
    "verificar": "npm run typecheck && npm test && npm run build && npm run build:single && npm run test:telas && npm run test:simulacao && npm run test:dialogos && npm run test:chave",
    "test:chave": "node test-navegador/chave-de-ia.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
