{
  "name": "financeiro-pessoal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Controle financeiro pessoal — lançamentos, contas recorrentes e compras parceladas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode singlefile && node scripts/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
